{
    "name": "zaeem2396/codelens",
    "description": "Framework-aware static code intelligence tool for Laravel and Symfony applications",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "laravel",
        "symfony",
        "static-analysis",
        "code-intelligence",
        "code-metrics",
        "developer-tools"
    ],
    "authors": [
        {
            "name": "zaeem2396",
            "homepage": "https://github.com/zaeem2396"
        }
    ],
    "homepage": "https://github.com/zaeem2396/codeLens",
    "require": {
        "php": "^8.1",
        "nikic/php-parser": "^5.0",
        "symfony/finder": "^6.0|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "CodeLens\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeLens\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeLens\\Adapters\\Laravel\\CodeLensServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

